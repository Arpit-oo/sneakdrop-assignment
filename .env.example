DATABASE_URL=postgres://sneak:sneak@localhost:5433/sneakdrop
TEST_DATABASE_URL=postgres://sneak:sneak@localhost:5433/sneakdrop_test
PORT=3000

# Sale rules
STOCK=20
HOLD_SECONDS=300
MAX_PER_USER=2

# Expiry worker sweep period (ms). 0 = API doesn't run it (use `npm run worker` instead)
EXPIRY_INTERVAL_MS=1000

# Shared secret between fake payment provider and webhook endpoint (HMAC-SHA256)
WEBHOOK_SECRET=change-me

# Fake payment provider chaos (webhooks go to WEBHOOK_URL, default http://localhost:$PORT/webhooks/payment)
# WEBHOOK_URL=
FAKEPAY_MAX_DELAY_MS=3000
FAKEPAY_DUPLICATE_RATE=0.3
FAKEPAY_REORDER_RATE=0.2
FAKEPAY_FAIL_RATE=0.1
